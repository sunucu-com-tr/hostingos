# HostingOS environment (docs/ARCHITECTURE.md §7).
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# Empty values are treated as unset.

# --- Database ---------------------------------------------------------------
# Pooled connection used by the application.
# `channel_binding=...` is stripped automatically (sqlx does not support it).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Direct (non-pooled) connection for migrations. Defaults to DATABASE_URL.
DATABASE_URL_DIRECT=

# --- Security ---------------------------------------------------------------
# Base64 of exactly 32 random bytes, e.g. `openssl rand -base64 32`.
# Encrypts integration credentials (AES-256-GCM). Losing it makes them unreadable.
HOS_SECRET_KEY=

# --- HTTP --------------------------------------------------------------------
# Listen address (default 127.0.0.1:8080).
HOS_BIND=127.0.0.1:8080
# The hosting company's public URL (default http://localhost:<port of HOS_BIND>).
HOS_BASE_URL=http://localhost:8080
# `single` (default): one hosting company on every host (`hostingos setup` or
# `hostingos seed-demo` creates it). `multi`: the advanced multi-company mode;
# needed for a database that holds several companies, such as the one the
# integration tests use.
HOS_MODE=single
# Multi-company mode only: companies get `<slug>.<HOS_BASE_DOMAIN>` (default
# localhost), and in debug mode bare `localhost` shows HOS_DEV_TENANT.
# HOS_BASE_DOMAIN=localhost
# HOS_DEV_TENANT=demo
# Behind a reverse proxy (docs/DEPLOYMENT.md, "Reverse proxies"): read the
# client address from its forwarding headers, but only on connections from
# HOS_TRUSTED_PROXIES (addresses / CIDR ranges; empty = every peer, with a
# warning at start-up).
# HOS_TRUST_PROXY=true
# HOS_TRUSTED_PROXIES=127.0.0.1,::1
# HOS_TRUSTED_PROXY_HOPS=1
# HOS_CLIENT_IP_HEADER=CF-Connecting-IP
# Slow clients: seconds for the request headers, the body and the whole
# request (defaults 120 / 60 / 120; 0 = no limit).
# HOS_HTTP_HEADER_TIMEOUT_SECS=120
# HOS_HTTP_BODY_TIMEOUT_SECS=60
# HOS_HTTP_REQUEST_TIMEOUT_SECS=120
# Apply pending migrations when `hostingos serve` starts (= serve --migrate).
# HOS_MIGRATE_ON_START=1

# --- OAuth (default apps; set both id and secret, or neither) ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI (Anthropic Claude Messages API) -------------------------------------
ANTHROPIC_API_KEY=
# Default model (default claude-opus-5-5).
HOS_AI_MODEL=claude-opus-5-5

# --- Logging (tracing-subscriber EnvFilter) ---------------------------------
# RUST_LOG=info,hos_web=debug,sqlx=warn
