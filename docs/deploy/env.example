# Production environment for docker-compose.yml (copy to .env.production,
# never commit the filled-in file). See docs/DEPLOYMENT.md for every variable.

# PostgreSQL password of the bundled database (compose builds DATABASE_URL from it).
# Deliberately empty: compose refuses to start until it is set. Generate one with
#   openssl rand -hex 32
# (hex keeps it URL-safe inside DATABASE_URL).
POSTGRES_PASSWORD=

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts integration
# credentials and TOTP secrets — back it up; losing it makes them unreadable.
HOS_SECRET_KEY=

# The hosting company's public URL: storefront at /, client area at /client,
# admin panel at /admin (https in production; enables Secure cookies). Point
# its host (A/AAAA or CNAME) at this server.
HOS_BASE_URL=https://panel.example.com
# `single` (default): one hosting company, served on every host that reaches
# the app. `multi` is the advanced mode for several companies at
# <slug>.HOS_BASE_DOMAIN with an operator console (docs/DEPLOYMENT.md).
HOS_MODE=single
# Only for HOS_MODE=multi: companies get <slug>.HOS_BASE_DOMAIN; point
# *.example.com at this host.
# HOS_BASE_DOMAIN=example.com
# Shared secret for Caddy's on-demand TLS "ask" request. Deliberately empty:
# compose refuses to start until it is set. Generate one with
#   openssl rand -hex 32
HOS_TLS_ASK_SECRET=
# Only for HOS_MODE=multi: public IPs of this host (comma separated) — custom
# domains with an A/AAAA record pointing here verify too (besides CNAME / TXT).
HOS_PUBLIC_IPS=
# Let's Encrypt account e-mail.
ACME_EMAIL=ops@example.com

# Where admin-configured integration endpoints (hypervisor/panel/SMTP/
# registrar/AI URLs) may connect: `private` (default; public + RFC 1918 / LAN
# addresses, so the company reaches its own servers on the LAN) or `public`
# (public addresses only). Loopback, link-local and cloud metadata addresses
# are refused either way. HOS_MODE=multi with several unrelated companies
# needs `public` (docs/DEPLOYMENT.md, "Outbound connections").
HOS_OUTBOUND_POLICY=private

# Behind Caddy only: 1 hop. Caddy ignores the X-Forwarded-For it receives
# unless the sender is in its `trusted_proxies`, so with a CDN in front
# (CDN → Caddy → app) either list the CDN's ranges there and set 2, or let
# the app read the CDN's own header (Cloudflare: CF-Connecting-IP; only safe
# when the server accepts connections from the CDN alone).
# HOS_TRUSTED_PROXY_HOPS=2
# HOS_CLIENT_IP_HEADER=CF-Connecting-IP
# Only Caddy may set the client address: the range of the stack's network,
#   docker network inspect hostingos_default --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# Empty: forwarding headers count from every peer (a warning at start-up).
HOS_TRUSTED_PROXIES=

# Slow clients: seconds for the request headers, the body and the whole
# request (defaults 120 / 60 / 120; 0 = no limit; docs/DEPLOYMENT.md).
# HOS_HTTP_HEADER_TIMEOUT_SECS=120
# HOS_HTTP_BODY_TIMEOUT_SECS=60
# HOS_HTTP_REQUEST_TIMEOUT_SECS=120

# Demo deployments only: allows the `mock` payment gateway / hypervisor /
# panel / registrar (a mock gateway lets anyone pay any invoice). Never set
# this in production.
# HOS_ALLOW_MOCK_INTEGRATIONS=1

# Updates (docs/UPDATES.md). Checks are OFF until a release source is set:
# the GitHub repository (owner/name) whose releases carry the signed
# manifest, or an HTTPS manifest URL. A check is a plain HTTPS GET; no
# telemetry is sent.
HOS_UPDATE_REPO=
# HOS_UPDATE_MANIFEST_URL=
# Image run by docker-compose.yml (it never builds; docker-compose.build.yml
# builds from a checkout instead). The default is
# ghcr.io/sunucu-com-tr/hostingos:edge: built from the main branch after CI
# passes, not a signed release, and it moves with every push to main. To pin
# one build, set HOS_TAG to its commit tag, sha-<first 7 hex digits of the
# commit>; `docker compose pull` then changes nothing until you change it.
# HOS_IMAGE=ghcr.io/sunucu-com-tr/hostingos
# HOS_TAG=edge

# Optional.
HOS_WORKER_CONCURRENCY=8
ANTHROPIC_API_KEY=
RUST_LOG=info,sqlx=warn
