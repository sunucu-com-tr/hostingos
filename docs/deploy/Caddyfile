# Caddy in front of HostingOS (docker-compose.yml).
#
# Certificates are issued on demand, on the first TLS handshake for a host.
# Before issuing, Caddy asks HostingOS whether the host belongs to it:
#   GET http://app:8080/internal/tls-allow?secret=…&domain=<host>
# → 200 for the company's address (HOS_BASE_URL) and HOS_BASE_DOMAIN
#   (plus, in the optional multi-company mode, <slug>.HOS_BASE_DOMAIN and
#   DNS-verified custom domains); 404 otherwise. Requests from outside loopback must carry the shared
#   secret (HOS_TLS_ASK_SECRET) — Caddy adds `domain` to the query below.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8080/internal/tls-allow?secret={$HOS_TLS_ASK_SECRET}
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:8080 {
		# HostingOS reads the client IP from X-Forwarded-For (HOS_TRUST_PROXY=true).
		header_up X-Forwarded-Proto {scheme}
		health_uri /healthz
		health_interval 15s
	}
}

http:// {
	redir https://{host}{uri} permanent
}
