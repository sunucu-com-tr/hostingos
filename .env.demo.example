# Environment of the public demo stack (docker-compose.demo.yml).
#
#   cp .env.demo.example .env.demo     # .env.demo is git- and docker-ignored
#
# Fill in the values marked REQUIRED; never commit the filled-in file. On
# Coolify, enter the same variables under the resource's Environment
# Variables instead (docs/deploy/DEMO-DEPLOY.md).

# REQUIRED. Password of the demo's own PostgreSQL. Generate:
#   openssl rand -hex 32
# (hex keeps it safe inside the connection URL.)
POSTGRES_PASSWORD=

# REQUIRED. Encryption key for integration credentials: 32 random bytes,
# base64. Generate:
#   openssl rand -base64 32
# Changing it later is harmless for the demo: the reset at every start
# re-creates every encrypted value.
HOS_SECRET_KEY=

# REQUIRED. Public https URL of the demo, without a trailing slash. Its host
# is the demo company's domain: storefront at /, client area at /client,
# admin panel at /admin (server pages at /admin/server) — all on this one
# host, no wildcard DNS. Any other host that reaches the app shows the demo too.
HOS_BASE_URL=https://demo.example.invalid

# Minutes between two resets of all demo data (5–1440). Default 30.
# Everything visitors enter is deleted at the next reset.
HOS_DEMO_RESET_MINUTES=30

# Client IP for the per-visitor rate limits (docs/deploy/DEMO-DEPLOY.md,
# "Proxies"). HOS_TRUST_PROXY=true: a reverse proxy sits in front of the app
# (Coolify's Traefik, Caddy …); only set false when nothing does.
#
# Behind Cloudflare (Cloudflare → Coolify's Traefik → app): set
# HOS_CLIENT_IP_HEADER=CF-Connecting-IP. Traefik's default configuration does
# not trust the X-Forwarded-For it receives and replaces it with Cloudflare's
# address, so no HOPS value can find the visitor there; the header can.
# HOS_TRUSTED_PROXY_HOPS then only matters as the fallback and stays 1.
#
# Without a CDN: leave HOS_CLIENT_IP_HEADER empty; HOPS = the number of
# proxies that append to X-Forwarded-For (1 for Traefik / Caddy alone).
#
# Recommended: HOS_TRUSTED_PROXIES = the address range of the Docker network
# the reverse proxy reaches the app through, e.g. on the server
#   docker network inspect <network> --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# The headers above then count only on connections from there. Empty: from
# every peer, with a warning at start-up.
HOS_TRUST_PROXY=true
HOS_TRUSTED_PROXIES=
HOS_TRUSTED_PROXY_HOPS=1
HOS_CLIENT_IP_HEADER=

# Optional. Slow clients: seconds for the request headers, the body and the
# whole request (defaults 120 / 60 / 120; 0 = no limit).
# HOS_HTTP_HEADER_TIMEOUT_SECS=120
# HOS_HTTP_BODY_TIMEOUT_SECS=60
# HOS_HTTP_REQUEST_TIMEOUT_SECS=120

# Not needed: demo mode always applies pending migrations before it serves
# (HOS_MIGRATE_ON_START / `hostingos serve --migrate`).

# Leave HOS_MODE unset: a demo is a single-company installation (the
# default); HOS_MODE=multi is refused in demo mode.

# Optional. A published image instead of building from the Dockerfile, e.g.
# ghcr.io/OWNER/hostingos:0.1.0 (then `docker compose … pull` and `up`
# without --build).
# HOS_DEMO_IMAGE=

# Optional. Logs: json (default) or text; filter.
# HOS_LOG_FORMAT=json
# RUST_LOG=info,sqlx=warn

# Optional, only with docker-compose.demo.ports.yml: where the app is
# published on the host (default 127.0.0.1:8080).
# HOS_DEMO_PUBLISH=127.0.0.1:8080
